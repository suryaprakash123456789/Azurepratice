{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "RetailClass"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"ls_sql_blob_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_blob'"
		},
		"ls_sqldatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqldatabase'"
		},
		"ls_sql_blob_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "shopdata.database.windows.net"
		},
		"ls_sql_blob_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "shopanalys"
		},
		"ls_sql_blob_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Edukron "
		},
		"ls_sqldatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "shop.database.windows.net"
		},
		"ls_sqldatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "master"
		},
		"ls_sqldatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Edukron"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "RetailClass_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"ls_sql_blob_password": {
						"value": "[parameters('ls_sql_blob_password')]"
					},
					"ls_sqldatabase_password": {
						"value": "[parameters('ls_sqldatabase_password')]"
					},
					"ls_sql_blob_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_blob_properties_typeProperties_server')]"
					},
					"ls_sql_blob_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_blob_properties_typeProperties_database')]"
					},
					"ls_sql_blob_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_blob_properties_typeProperties_userName')]"
					},
					"ls_sqldatabase_properties_typeProperties_server": {
						"value": "[parameters('ls_sqldatabase_properties_typeProperties_server')]"
					},
					"ls_sqldatabase_properties_typeProperties_database": {
						"value": "[parameters('ls_sqldatabase_properties_typeProperties_database')]"
					},
					"ls_sqldatabase_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqldatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}